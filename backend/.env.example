# Secret de signature des jetons JWT (OBLIGATOIRE en production)
JWT_SECRET=remplacez-par-un-secret-long-et-aleatoire

# Durée de validité des jetons (ex. 12h, 7d)
JWT_EXPIRES=12h

# Port d'écoute de l'API
PORT=8787

# Chemin du fichier SQLite (défaut : backend/data/wavesoft.db)
# DB_PATH=/var/data/wavesoft.db
